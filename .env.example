## 服务器
HOST=0.0.0.0
PORT=3000

## LLM（vLLM / OpenAI 兼容接口）
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=sk-placeholder  # 本地 vLLM 占位（模型在本地跑，非真实云 key；按需替换）
LLM_MODEL=gemma-4-26b

## CORS（逗号分隔）
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

## 数据目录（默认 ./data）
# IDATE_DATA_DIR=/path/to/data

## Cookie 签名密钥（session cookie 加密；不设则每次重启随机生成，所有已登录用户会被登出）
## 生产环境务必设一个固定随机值：openssl rand -hex 32
COOKIE_SECRET=

## 向量检索服务（bge-base-zh，独立进程跑在 8001 端口）
# EMBEDDING_URL=http://127.0.0.1:8001
# EMBEDDING_MODEL=Qwen3-Embedding-8B

## vLLM 最大模型长度（与 vLLM 启动参数 --max-model-len 一致）
# VLLM_MAX_MODEL_LEN=16384
